Options -Indexes

# Optional HTTPS redirect for production only.
# Enable this block only after SSL is active on the live domain.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Block sensitive config, logs, backups, and environment files.
<FilesMatch "(\.env|env\.php|\.log|\.sql|\.bak|\.zip|composer\.(json|lock)|package(-lock)?\.json|README|readme|config\.example\.php)$">
  Require all denied
</FilesMatch>

# Block direct access to hidden files.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
